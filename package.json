    "demo:smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-demo.ps1 -Mode smoke",
    "demo:partial": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-demo.ps1 -Mode partial"
  },
  "devDependencies": {
