{
  "name": "factory-e2e-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:list": "playwright test --list",
    "test:headed": "playwright test --headed",
    "test:分阶段验证": "playwright test e2e/冒烟/数据工厂-分阶段验证.spec.ts --project=chromium",
    "test:自有数据闭环": "cmd /c scripts\\执行自有数据闭环.cmd",
    "test:并行回归": "cmd /c scripts\\执行并行回归.cmd",
    "ftp:本地启动": "node scripts/启动本地FTP-SFTP.mjs",
