    "basic-ftp": "^6.2.0",
    "ftp-srv": "^4.6.3",
    "mysql2": "^3.23.3",
    "pg": "^8.23.0",
    "ssh2": "^1.17.0",
    "ssh2-sftp-client": "^12.1.1",
    "ssh2-sftp-server": "^1.1.2",
    "typescript": "^5.8.0"
