# Public repository allowlist. New files are ignored until explicitly reviewed.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/AGENTS.md
!/package.json
!/package-lock.json
!/playwright.config.ts
!/tsconfig.json
!/.env.example
!/环境检查清单.md
!/部署与执行清单.md
!/.githooks/
/.githooks/*
!/.githooks/pre-push

!/e2e/
/e2e/*
!/e2e/test-environment.ts
!/e2e/工厂/
/e2e/工厂/*
!/e2e/工厂/湖南中行/
/e2e/工厂/湖南中行/**
!/e2e/工厂/湖南中行/**/
!/e2e/工厂/湖南中行/**/*.ts
!/e2e/工厂/湖南中行/**/*.md
!/e2e/工厂/湖南中行/**/*.csv
!/e2e/工厂/湖南中行/**/*.txt
!/e2e/工厂/湖南中行/**/*.xls
!/e2e/工厂/湖南中行/**/*.xlsx
!/e2e/工厂/湖南中行/project.marker
!/e2e/工厂/湖南中行/资源/字段血缘/SFTP/e2e_lineage_sftp_*
!/e2e/工厂/湖南中行/资源/字段血缘/文件接入/e2e_lineage_file_source
/e2e/工厂/湖南中行/资源/字段血缘/文件接入/generate-fld-excel-fixtures.result.txt

!/e2e-testing/
/e2e-testing/*
!/e2e-testing/*.md

# Defense in depth: secrets and generated content stay local even under allowed trees.
**/.env
**/.env.*
!/.env.example
**/node_modules/
**/playwright-report/
**/test-results/
**/temp/
**/logs/
**/outputs/
**/.cline*/
**/*.inspect.ndjson
**/*credential*
**/*secret*
